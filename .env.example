# Copy to .env.local and fill in. All values are server-side only.

# Database: local SQLite file by default; use libsql://... + token for Turso.
DATABASE_URL=file:./data/app.db
# DATABASE_AUTH_TOKEN=

# Public origin without trailing slash. Production must be https.
SITE_URL=http://localhost:3000

# 32+ random characters (openssl rand -base64 36). Required in production.
AUTH_SECRET=

# 32+ random characters. Encrypts the Midtrans server keys premium members
# save in Settings. Never change it once keys are stored.
ENCRYPTION_KEY=

# Where uploaded images and private product files are stored.
STORAGE_DIR=./storage

# Midtrans (only for direct checkout). Sandbox keys start with SB-.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Used once by `npm run setup`. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Adhi Nugroho
ADMIN_USERNAME=adhinugroho
# SETUP_STARTER_CONTENT=false
